# ===== FoxCash Bots (Spec 52) =====
# Copie para `.env` e preencha. Segredos SÓ por env — nunca em código/repo.

# URL pública do backend FoxCash (dev: app local).
FOXCASH_BASE_URL=http://localhost:8080

# API key do lojista dono da loja (Spec 12/24). Chave de serviço dedicada se
# quiser isolar escopos (Spec 24).
FOXCASH_API_KEY=mch_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Segredo do webhook de saída configurado no portal
# (POST /api/v1/portal/webhooks — devolvido UMA vez). O bot valida o HMAC do
# envelope SALE_PAID/SALE_REFUNDED com este segredo (Spec 35).
WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Porta do receiver HTTP (webhooks de saída do FoxCash).
WEBHOOK_PORT=3000

# Intervalo de polling de pendências (entregas + mensagens programadas), ms.
DELIVERY_POLL_MS=15000

# ===== Gateway (Spec 150) =====
# Id do store_bot (Spec 74/75) — atribui a venda ao bot (funil/métricas/ranking).
# Vazio = envia sem botId (compatibilidade em dev).
FOXCASH_BOT_ID=
# Gateway usado pelo bot (hoje apenas 'foxcash').
FOXCASH_GATEWAY_TYPE=foxcash

# ===== Discord =====
# Token do bot (https://discord.com/developers/applications). Vazio = bot desligado.
DISCORD_TOKEN=
# Guild (servidor) onde o bot entrega cargos (grant_role).
GUILD_ID=

# ===== Telegram =====
# Token do bot (https://t.me/BotFather). Vazio = bot desligado.
TELEGRAM_BOT_TOKEN=

# ===== ACL admin =====
# IDs (separados por vírgula) autorizados aos comandos /admin *.
ADMIN_DISCORD_IDS=
ADMIN_TELEGRAM_IDS=

# Nível de log: debug | info | warn | error
LOG_LEVEL=info
