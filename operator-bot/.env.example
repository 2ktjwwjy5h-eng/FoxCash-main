# FoxCash Operator Bot — env vars (Spec 67)

# Discord
OPERATOR_DISCORD_TOKEN=          # token do bot (portal.developers.discord.com — pré-requisito)
OPERATOR_CHANNEL_ID=             # canal único onde o bot responde (alternativa ao OPERATOR_CHANNELS)
OPERATOR_CHANNELS=               # allowlist de canais (IDs separados por vírgula): saúde-sistema, ops, comando-controle, resumos-periodicos, segurança-auditoria, pulsação-financeira…

# Webhooks por categoria (integrações do servidor Discord — 6 itens)
# Comandos interativos respondem no canal (reply); os webhooks recebem os
# proativos: diário/semanal → SUMMARIES · anomalia → FIN_PULSE. As demais
# categorias ficam prontas p/ futuros proativos. Sem webhook → cai no
# OPERATOR_CHANNEL_ID; sem canal → log.
WEBHOOK_CMD=                     # comando e controle
WEBHOOK_OPS=                     # OPS
WEBHOOK_FIN_PULSE=               # pulsação financeira (alerta de anomalia de vendas)
WEBHOOK_SUMMARIES=               # resumos periódicos (resumo diário 09:00 + semanal seg 09:00)
WEBHOOK_HEALTH=                  # saúde e sistema
WEBHOOK_SECURITY=                # segurança e auditoria

# Banco (leitura) — PostgreSQL do FoxCash
DATABASE_URL=postgresql://user:pass@host:5432/railway

# Railway (status/deploy/logs)
RAILWAY_TOKEN=                   # token de API (dashboard → Account Settings → Tokens) p/ !deploy/!bloqueios/!ip/!log
RAILWAY_OPS_SERVICE_ID=          # serviço OPERADO (ex.: backend FoxCash) — status/logs; default: próprio serviço do bot
RAILWAY_PROJECT=                 # ex.: foxcash-prod (default: linkado)

# Backend
FOXCASH_BASE_URL=https://api.foxcash.example.com
FOXCASH_ADMIN_API_KEY=               # chave admin p/ /actuator/prometheus (!latencia)

# Cloudflare (!bloquear <ip> — token escopado da zona, Spec 66/R1)
CF_API_TOKEN=
CF_ZONE_ID=<CF_ZONE_ID>

# Agendados (cron, TZ local do processo)
SCHED_DAILY_CRON=0 9 * * *       # resumo diário 09:00
SCHED_WEEKLY_CRON=0 9 * * 1      # resumo semanal (segunda 09:00)
ANOMALY_THRESHOLD=0.5            # vendas/hora < 50% da média → alerta
